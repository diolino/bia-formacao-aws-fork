        <mxCell id="gUZ4lYMvAPcV1kicZjh6-12" parent="gUZ4lYMvAPcV1kicZjh6-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Principais Tipos de Recurso&lt;/h1&gt;&lt;p&gt;&lt;b&gt;&lt;font style=&quot;color: rgb(0, 102, 0);&quot;&gt;# Ec2: Instance : 36.&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;color: rgb(0, 102, 0);&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;# RDS : 3 (OK)&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;# EKS: 2 cluesters (lab e hml) * Versão obsoleta do kubernetes&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;# EBS: OK (planilha)&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;# S3:&lt;/b&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp;OK(planilha)&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;# EFS: OK&lt;/b&gt;&lt;/p&gt;&lt;p&gt;- File Systems: 0&lt;/p&gt;&lt;p&gt;- Access points: 0&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;# DynamoDB: 1 (OK).&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b style=&quot;&quot;&gt;# AWS Backup: OK.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;ELB:&amp;nbsp; OK (desenho)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;NLB: OK (desenho)&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;&lt;font style=&quot;color: rgb(0, 102, 0);&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;# WAF:2 (&lt;/b&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;Acesso-PJe-hml ;&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;Acesso-PJe-trn&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;): OK.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;# VPC Peering 0: OK.&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;# VPC Endpoints: 1 OK&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;- 1 Gateway (S3) :&amp;nbsp;vpce-0bbbf7794d89a7029&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;# NGW: 0.(aparentemente usam nat instance)&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;# IGW: 1 (OK)&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;# EIP: 5.(aparentemente 2 soltos)&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;# Lambda: OK&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;# AMIs: 0. OK&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;VPN (Gateway, Client Gateway, VPN Conn): OK&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;- Uma conexão.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;# CloudTrail: OK.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;2 Trail (1 na conta/S3, 1 cross account/S3/TST)&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;# CloudWatch: Ok.&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p&gt;-&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;b&gt;OpenSearch: OK (0)&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;#KMS&lt;/b&gt;&lt;/p&gt;&lt;p&gt;- Customer Keys: 6 chaves.&lt;/p&gt;&lt;p&gt;- AWS Managed Keys: 7 (&lt;span style=&quot;background-color: transparent;&quot;&gt;aws/s3&amp;nbsp; ;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;)&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;aws/lambda&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;# ROUTE 53: OK.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;# Cost Explorer: OK.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;# Trusted Advisor&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Atenção: Recursos não default for de SA-EAST1:&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;-resourcetype:ec2:subnet -region:sa-east-1 -region:Global -resourcetype:ec2:internet-gateway -resourcetype:ec2:vpc -resourcetype:ec2:route-table -resourcetype:ec2:security-group -resourcetype:ec2:network-acl -resourcetype:ec2:dhcp-options -resourcetype:ec2:security-group-rule&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="2521" width="366" x="81" y="-228" as="geometry" />
        </mxCell>
        <mxCell id="gUZ4lYMvAPcV1kicZjh6-13" parent="gUZ4lYMvAPcV1kicZjh6-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Subnets&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;public-subnet-pje-trt24-prd (subnet-02e562cd86e74c1ff) - 1 EC2&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;public-subnet-pje-trt24-prd (subnet-0ea8303ba5239de25) - 1 EC2&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;public-subnet-pje-trt24-prd (&lt;span style=&quot;background-color: transparent;&quot;&gt;subnet-0594285fbe079a561&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;) - 2 EC2&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;private-subnet-pje-trt24-prd (subnet-019a40389a848113c) - 21 EC2 +&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;EKS&lt;/b&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;database-subnet-pje-trt24-prd (subnet-062565e8e231c773e) - 18 EC2 - RD&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;database-subnet-pje-trt24-prd (subnet-0a9bce468dca629ae) - 0EC2 -&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;RDS (1)&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;database-subnet-pje-trt24-prd (subnet-05f919a7ed4b27c17) - 0 EC2 - RDS (0)&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;p&g