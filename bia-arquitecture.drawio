        <mxCell id="VW7wKqiGTSmk1Jp1lLcU-28" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Análise da arquitetura de armazenamento e backup nos ambientes produtivos e não produtivos dos &lt;/span&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;TRTs 8, 24, 17&lt;/b&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; e geração de recomendações de melhorias.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;Objetivo Principal: Otimização dos custos de armazenamento e banco de dados sem comprometimento da segurança e continuidade do negócio.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="gS17R3fkGbp86zG7nFje-1" vertex="1">
